{
  "name": "twitchterino",
  "productName": "Twitchterino",
  "version": "0.1.0",
  "description": "Cliente multi-chat da Twitch (estilo Chatterino, adaptado do Kickterino) que mantém você assistindo lives para acumular pontos do canal.",
  "author": "onlyzennnn",
  "license": "MIT",
  "repository": "github:onlyzennnn/twitchterino",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.onlyzennnn.twitchterino",
    "productName": "Twitchterino",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "onlyzennnn",
        "repo": "twitchterino"
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "build/icon.png"
    ],
    "electronFuses": {
      "enableCookieEncryption": true,
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "artifactName": "Twitchterino-Setup.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Twitchterino",
      "runAfterFinish": true
    },
    "portable": {
      "artifactName": "Twitchterino-portatil.exe"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network",
      "executableName": "twitchterino",
      "synopsis": "Chat e pontos da Twitch para o PokeIdle",
      "maintainer": "onlyzennnn <1506vinicius.fernando@gmail.com>",
      "syncDesktopName": true
    },
    "appImage": {
      "artifactName": "Twitchterino-linux.AppImage"
    },
    "deb": {
      "artifactName": "Twitchterino-linux.deb"
    }
  },
  "desktopName": "twitchterino.desktop"
}
